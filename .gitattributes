# Auto detect text files and perform LF normalization
* text=auto

# C# source files use LF (matches CSharpier endOfLine config)
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ruleset text eol=lf

# Shell scripts must use LF line endings
*.sh text eol=lf

# Batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Dockerfiles use LF
Dockerfile* text eol=lf
